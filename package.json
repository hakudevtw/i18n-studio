{
  "name": "i18n-studio",
  "version": "0.1.0",
  "description": "Review-status layer and export/import loop for translation JSON.",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@12.9.1",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hakudevtw/i18n-studio.git"
  },
  "homepage": "https://github.com/hakudevtw/i18n-studio#readme",
  "bugs": {
    "url": "https://github.com/hakudevtw/i18n-studio/issues"
  },
  "keywords": [
    "i18n",
    "localization",
    "translation",
    "cli"
  ],
  "bin": {
    "i18n-studio": "dist/bin.js"
  },
  "files": [
    "dist",
    "skills",
    "README.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/build-ui.mjs && chmod +x dist/bin.js",
    "build:ui": "node scripts/build-ui.mjs",
    "pretest": "node scripts/build-ui.mjs",
    "test:coverage": "vitest run --coverage",
    "pretest:coverage": "node scripts/build-ui.mjs",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "biome check .",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "changeset publish",
    "prepack": "pnpm build"
  },
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/",
    "provenance": true
  },
  "peerDependencies": {
    "exceljs": "^4.4.0"
  },
  "peerDependenciesMeta": {
    "exceljs": {
      "optional": true
    }
  },
  "devDependencies": {
    "@biomejs/biome": "2.3.4",
    "@changesets/cli": "3.0.3",
    "@types/node": "22.20.5",
    "@vitest/coverage-v8": "4.1.11",
    "esbuild": "0.28.2",
    "exceljs": "4.4.0",
    "jsdom": "29.1.1",
    "preact": "11.0.0",
    "typescript": "7.0.2",
    "ultracite": "6.3.2",
    "vitest": "4.1.11"
  }
}
